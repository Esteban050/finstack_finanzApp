      "name": "60 · RN-017.1 Sincronización con la fuente oficial",
      "item": [
        {
          "name": "60.1 POST /admin/trm/sincronizar · forzar la consulta (RN-017.1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sale a datos.gov.co: con internet responde 200; sin internet, o si la",
                  "// fuente aún no publica la TRM de hoy, 503 y el intento queda en bitácora.",
                  "pm.test('RN-017.1 · responde 200 (sincronizada) o 503 (fuente no disponible)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
                  "    pm.expect(pm.response.json()).to.have.property('mensaje');",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test('RN-017.1 · la TRM obtenida cubre el día de hoy', function () {",
                  "        const d = pm.response.json().data;",
                  "        pm.expect(d.es_tasa_anterior).to.be.false;",
                  "        pm.expect(d.vigencia_desde <= d.fecha_consultada, 'no debe guardar la TRM de mañana como la de hoy').to.be.true;",
                  "        pm.expect(d.vigencia_hasta >= d.fecha_consultada).to.be.true;",
                  "        pm.expect(Number(d.valor)).to.be.above(0);",
                  "    });",
                  "} else {",
                  "    pm.test('RN-017.1 · el fallo informa el número de intento del día', function () {",
                  "        pm.expect(pm.response.json().mensaje).to.include('intento');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"

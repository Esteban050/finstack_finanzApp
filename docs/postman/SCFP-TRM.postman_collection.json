    {
      "name": "10 · RF-017 Consulta de la TRM",
      "item": [
        {
          "name": "10.1 GET /tasas-cambio/trm · TRM de hoy y su última actualización (RF-017)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const p = (n) => String(n).padStart(2, '0');",
                  "const d = new Date();",
                  "pm.collectionVariables.set('fecha_hoy', `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('RF-017 · la TRM de hoy está disponible', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const d = pm.response.json().data;",
                  "",
                  "pm.test('RF-017 · trae valor, vigencia, fuente y última actualización', function () {",
                  "    pm.expect(d.moneda).to.eql('USD');",
                  "    pm.expect(Number(d.valor)).to.be.above(0);",
                  "    pm.expect(d.fecha_consultada).to.eql(pm.collectionVariables.get('fecha_hoy'));",
                  "    pm.expect(d).to.have.property('vigencia_desde');",
                  "    pm.expect(d).to.have.property('vigencia_hasta');",
                  "    pm.expect(['DATOS_ABIERTOS', 'MANUAL']).to.include(d.fuente);",
                  "    pm.expect(Date.parse(d.ultima_actualizacion), 'ultima_actualizacion debe ser ISO 8601').to.not.be.NaN;",
                  "});",
                  "",
                  "pm.test('RN-017.2 · la vigencia empieza en la fecha consultada o antes', function () {",
                  "    pm.expect(d.vigencia_desde <= d.fecha_consultada).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrf}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/tasas-cambio/trm",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "tasas-cambio",
                "trm"
              ]
            }
          }
        },
